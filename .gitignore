# local overrides, never committed
.env
server/services/*/config/config.local.yaml
server/cmd/migrate/config/config.local.yaml

# build and test output; go build in server/ leaves a binary named after its package
bin/
/server/migrate
/server/gameserver
/server/bot
/server/account
/server/character
/server/item
/server/world
/server/social
/server/gateway
coverage.out
coverage.html
coverage.tmp

# client build output and dependencies; maps are copied from server/data/ at build time
web/node_modules/
web/dist/
web/public/maps/

# client coverage output
web/coverage/
web/src/gamedata/
