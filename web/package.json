{
  "name": "finga-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "gen": "node scripts/gen-gamedata.ts",
    "predev": "npm run gen && node scripts/copy-maps.mjs",
    "dev": "vite",
    "prebuild": "npm run gen && node scripts/copy-maps.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "pretypecheck": "npm run gen",
    "typecheck": "tsc --noEmit",
    "prelint": "npm run gen",
    "lint": "eslint . --max-warnings 0 && prettier --check . && node scripts/check-layers.mjs",
    "format": "prettier --write .",
    "pretest": "npm run gen && node scripts/copy-maps.mjs",
    "test": "vitest run",
    "precoverage": "npm run gen && node scripts/copy-maps.mjs",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "phaser": "4.2.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "valibot": "1.5.0",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "4.1.12",
    "yaml": "2.9.1"
  }
}
