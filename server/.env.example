# .env.example: copy to .env (git-ignored) and uncomment what you need.
# The binaries never read this file: make up passes it to every service
# container (Compose's env_file) and make run exports it before starting
# them. Values are environment variables over configs/config.yaml. Quote a
# value with spaces or & in it; both Compose and the shell read the file.
# make up sets FINGA_DATABASE_URL and FINGA_SERVER_CORS_ORIGINS itself
# (infra/docker-compose.yml), and those win over this file there.

# Which YAML file to load (default: configs/config.local.yaml if present, else config.yaml)
# CONFIG_PATH=configs/config.yaml

# FINGA_SERVER_ADDR=:8080
# A list is comma-separated. For a LAN playtest add http://<your LAN IP>:5173.
# FINGA_SERVER_CORS_ORIGINS=http://localhost:5173
# FINGA_SERVER_SHUTDOWN_GRACE=10s

# FINGA_DATABASE_URL=postgres://finga:finga@localhost:5432/finga?sslmode=disable
# FINGA_DATABASE_MAX_CONNS=20

# FINGA_WORLD_TICK_RATE_HZ=20
# FINGA_WORLD_CHECKPOINT_INTERVAL=30s
# FINGA_WORLD_DATA_DIR=data

# FINGA_ECONOMY_WORKERS=8

# FINGA_TELEMETRY_LOG_LEVEL=debug

# Where each internal service listens (gRPC), is dialled, and serves its
# /healthz, /readyz and /metrics. Compose sets every *_ADDR to the service's
# name; without Docker the defaults (localhost) fit.
# FINGA_SERVICES_ACCOUNT_LISTEN=:9001
# FINGA_SERVICES_ACCOUNT_ADDR=localhost:9001
# FINGA_SERVICES_ACCOUNT_OPS=:9101
# (the same three keys for CHARACTER 9002/9102, ITEM 9003/9103, WORLD 9004/9104, SOCIAL 9005/9105)
