# .env.example: copy to .env (git-ignored) and uncomment what you need.
# The binaries never read this file: make up passes it to every service
# container (Compose's env_file) and make run exports it before starting
# them, so a value here reaches every binary that has the key; each binary
# reads only its own keys (Low-level design, page 11). Quote a value with
# spaces or & in it; both Compose and the shell read the file. make up sets
# each service's database and the addresses it dials itself
# (infra/docker-compose.yml), and those win over this file there.
#
# To change one service only, put a config.local.yaml beside its committed
# services/<name>/config/config.yaml (git-ignored): it replaces that file.

# Every binary
# FINGA_LOG_LEVEL=debug
# FINGA_SHUTDOWN_GRACE=10s

# account, character, item and migrate
# FINGA_DATABASE_URL=postgres://finga:finga@localhost:5432/finga?sslmode=disable

# The gateway. A list is comma-separated.
# FINGA_HTTP_ADDR=:8080
# FINGA_HTTP_CORS_ORIGINS=http://localhost:5173

# The world
# FINGA_TICK_RATE_HZ=20
# FINGA_CHECKPOINT_INTERVAL=30s
# FINGA_ECONOMY_WORKERS=8
