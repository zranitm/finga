# Copy to .env (git-ignored) and uncomment what you need; make up and make run pass it to every binary.
# Quote a value with spaces or &: Compose and the shell both read it. Compose's own entries win over it.
# For one service only, a git-ignored config.local.yaml beside its config.yaml replaces that file.

# Every binary
# FINGA_LOG_LEVEL=debug
# FINGA_LOG_FORMAT=console
# FINGA_LOG_SOURCE=true
# FINGA_SHUTDOWN_GRACE=10s

# account, character, item and migrate
# FINGA_DATABASE_URL=postgres://finga:finga@localhost:5432/finga?sslmode=disable

# The gateway. A list is comma-separated.
# FINGA_HTTP_ADDR=:8080
# FINGA_HTTP_CORS_ORIGINS=http://localhost:5173

# The world
# FINGA_TICK_RATE_HZ=20
# FINGA_CHECKPOINT_INTERVAL=30s
# FINGA_ECONOMY_WORKERS=8
