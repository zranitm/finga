# Copy to .env (git-ignored) and uncomment what you need: make run exports it to every binary, make up passes it to the six services but not migrate, Compose's own entries win, and a value with spaces or & needs quotes.

# Every binary
# FINGA_LOG_LEVEL=debug
# FINGA_LOG_FORMAT=console
# FINGA_LOG_SOURCE=true
# FINGA_SHUTDOWN_GRACE=10s

# account, character, item and migrate
# FINGA_DATABASE_URL=postgres://finga:finga@localhost:5432/finga?sslmode=disable

# The gateway. A list is comma-separated.
# FINGA_HTTP_ADDR=:8080
# FINGA_HTTP_CORS_ORIGINS=http://localhost:5173

# The world: a module's own key is under its section
# FINGA_WORLD_TICK_RATE_HZ=20
# FINGA_WORLD_CHECKPOINT_INTERVAL=30s
# FINGA_WORLD_ITEM_CALLS_WORKERS=8
# FINGA_WORLD_ITEM_CALLS_BATCH_MAX=32
