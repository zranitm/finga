# The production settings deploy.sh exports before every Compose call: Compose's own variables, then the deploy's.
# Nothing secret: the database password, the TLS key and the like come from SSM under the host's SSM_PREFIX.
# The host's own settings (region, bucket, registry, SSM prefix) are in /etc/compose-host/host.env, which Terraform writes.

# Relative to the release directory, which every Compose call runs from.
COMPOSE_FILE=infra/docker-compose.yml:infra/deploy/obs.prod.yml:infra/deploy/compose.prod.yml
# The observability stack runs beside the game, and the services send it their traces.
COMPOSE_PROFILES=obs
FINGA_TRACING_OTLP_ENDPOINT=alloy:4317

# Stop the game before starting the new release (the README's rule: one version at a time). Services under a
# profile, the observability stack, keep running and collect the last logs.
DEPLOY_STOP_FIRST=1
# Every container with a health check must be healthy within this long, then each URL must answer 2xx.
DEPLOY_HEALTH_TIMEOUT=300
DEPLOY_CHECK_URLS="http://127.0.0.1:9100/readyz https://127.0.0.1/"
# systemd units installed from the release, prefixed with the app name: the nightly database backup.
DEPLOY_SYSTEMD_DIR=infra/deploy/systemd
DEPLOY_KEEP_RELEASES=5
DEPLOY_IMAGE_PRUNE_AFTER=168h

# pg-backup.sh and pg-restore.sh: the Compose service running Postgres, and where its dumps go in the artifact bucket.
BACKUP_POSTGRES_SERVICE=postgres
BACKUP_PREFIX=backups/postgres
