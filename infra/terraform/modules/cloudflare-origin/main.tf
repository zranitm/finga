# A hostname proxied by Cloudflare to one origin address, with an Origin CA certificate for Full (strict) TLS and
# Cloudflare's address ranges for the origin's firewall and its real-client-IP setting.

terraform {
  required_version = ">= 1.10"

  required_providers {
    cloudflare = {
      source  = "cloudflare/cloudflare"
      version = ">= 5.0"
    }
    tls = {
      source  = "hashicorp/tls"
      version = ">= 4.0"
    }
  }
}

variable "zone_id" {
  type = string
}

variable "hostname" {
  description = "Fully qualified, e.g. play.example.com."
  type        = string
}

variable "ipv4_address" {
  description = "The origin's public address."
  type        = string
}

variable "certificate_validity_days" {
  description = "Origin CA certificate lifetime: 7, 30, 90, 365, 730, 1095 or 5475 days."
  type        = number
  default     = 5475
}

variable "zone_settings" {
  description = "Zone settings to manage, e.g. { ssl = \"strict\" }. They apply to the whole zone, not just hostname."
  type        = map(string)
  default     = {}
}

data "cloudflare_ip_ranges" "this" {}

resource "cloudflare_dns_record" "this" {
  zone_id = var.zone_id
  name    = var.hostname
  type    = "A"
  content = var.ipv4_address
  proxied = true
  ttl     = 1 # automatic, as every proxied record
  comment = "Managed by Terraform"
}

resource "tls_private_key" "origin" {
  algorithm   = "ECDSA"
  ecdsa_curve = "P256"
}

resource "tls_cert_request" "origin" {
  private_key_pem = tls_private_key.origin.private_key_pem
  dns_names       = [var.hostname]

  subject {
    common_name = var.hostname
  }
}

resource "cloudflare_origin_ca_certificate" "this" {
  csr                = tls_cert_request.origin.cert_request_pem
  hostnames          = [var.hostname]
  request_type       = "origin-ecc"
  requested_validity = var.certificate_validity_days
}

resource "cloudflare_zone_setting" "this" {
  for_each = var.zone_settings

  zone_id    = var.zone_id
  setting_id = each.key
  value      = each.value
}

locals {
  cidrs = concat(data.cloudflare_ip_ranges.this.ipv4_cidrs, data.cloudflare_ip_ranges.this.ipv6_cidrs)
}

output "cloudflare_ipv4_cidrs" {
  description = "Cloudflare's IPv4 ranges: the only sources the origin should accept."
  value       = data.cloudflare_ip_ranges.this.ipv4_cidrs
}

output "cloudflare_ipv6_cidrs" {
  value = data.cloudflare_ip_ranges.this.ipv6_cidrs
}

output "certificate_pem" {
  value = cloudflare_origin_ca_certificate.this.certificate
}

output "private_key_pem" {
  value     = tls_private_key.origin.private_key_pem
  sensitive = true
}

output "nginx_realip_conf" {
  description = "nginx directives that take the client address from CF-Connecting-IP when the peer is Cloudflare."
  value = join("\n", concat(
    ["# Generated by Terraform from Cloudflare's published ranges: behind Cloudflare, the client is CF-Connecting-IP."],
    [for cidr in local.cidrs : "set_real_ip_from ${cidr};"],
    ["real_ip_header CF-Connecting-IP;", ""],
  ))
}
