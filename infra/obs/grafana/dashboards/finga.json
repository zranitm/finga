    {
      "type": "timeseries",
      "id": 8,
      "title": "Item calls in flight",
      "description": "Calls to the item service queued or running, and how many drops each grant call carries: batches grow when the item service answers slowly.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum(finga_item_calls_inflight)",
          "legendFormat": "in flight"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum(rate(finga_ws_slow_consumer_disconnects_total[$__rate_interval]))",
          "legendFormat": "slow consumers kicked /s"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum(rate(finga_item_calls_batch_size_sum[$__rate_interval])) / sum(rate(finga_item_calls_batch_size_count[$__rate_interval]))",
          "legendFormat": "drops per grant call"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(finga_item_calls_batch_size_bucket[$__rate_interval])))",
          "legendFormat": "drops per grant call, p95"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 23,
      "title": "Saves dropped",
      "description": "Checkpoints the world gave up on, so progress lost, by why. One at shutdown comes after the last scrape: find it in the logs, \"persistence failed\" with dropped=shutdown.",
