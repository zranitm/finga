# Copy to .env (git-ignored): the host ports Compose publishes. The game's own settings go in ../server/.env.

# Postgres on the host; for make run, point FINGA_DATABASE_URL in ../server/.env at it too.
# FINGA_POSTGRES_PORT=5432

# The game in the browser (nginx).
# FINGA_WEB_PORT=4173

# The game's API on the host, for make smoke and make bots.
# FINGA_PORT=8080

# The game's ops port (/healthz, /readyz, /metrics), which CI waits on and make bots reads.
# FINGA_OPS_PORT=9100

# Grafana, under make up OBS=1.
# FINGA_GRAFANA_PORT=3000
