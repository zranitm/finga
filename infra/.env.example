# .env.example: copy to .env (git-ignored) next to docker-compose.yml.
# Compose reads it for the ${...} values in the Compose file: the host ports
# the stack publishes. The services' own settings go in ../server/.env.

# Postgres on the host; change it when another Postgres owns 5432 (and point
# FINGA_DATABASE_URL in ../server/.env at it for make run).
# FINGA_POSTGRES_PORT=5432

# The game in the browser: nginx serving the client (the web service).
# FINGA_WEB_PORT=4173

# The gateway on the host, for make smoke and make bots.
# FINGA_PORT=8080

# The world service's ops port (/metrics), which make bots reads.
# FINGA_WORLD_OPS_PORT=9104
